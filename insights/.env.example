# Video Insights settings. Copy this file to .env.local and fill it in.
# Never commit .env.local or paste these values into a page or a chat.

# Signs the sign-in cookie and encrypts the saved Google permissions. Make one with: openssl rand -base64 32
AUTH_SECRET=

# The Google Cloud OAuth client (the same one Explainer Studio uses is fine).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The secret Explainer Studio sends with each upload. Use the same value in Studio's INSIGHTS_SECRET.
INSIGHTS_SECRET=

# The secret the scheduler sends to /api/cron. Vercel sends it by itself once it is set.
CRON_SECRET=

# Postgres address, for example from Neon. Leave blank on your own computer to use the built-in database in .data/.
DATABASE_URL=

# Optional: OpenAI writes the reasons in plain words. Without it, the built-in rules write them.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REASONING_EFFORT=

# Optional: who may sign in (addresses and @domains, separated by commas). Blank means anyone with a channel.
ALLOWED_EMAILS=

# Optional: Explainer Studio's address, for a link back to it.
STUDIO_URL=
