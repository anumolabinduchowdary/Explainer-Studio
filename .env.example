# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your OpenAI API key. Read on the server only; it is never sent to the browser
# and never logged. Leave it blank to run in "bring your own key" mode, where
# each visitor pastes their own key (held in their browser's memory only).
OPENAI_API_KEY=

# Required. The text model that structures prompts and writes storyboards.
# Model names change: check https://developers.openai.com/api/docs/models
# "gpt-6.1-sol" balances quality and cost; "gpt-6-luna" is cheaper and faster.
OPENAI_TEXT_MODEL=gpt-6.1-sol

# Optional. How hard the model "thinks" (for example: low, medium, high).
# Lower is faster and cheaper. Leave blank to use the model's default, or if
# your model does not support reasoning settings.
OPENAI_REASONING_EFFORT=low

# Needed for Cartoon stories only. The image model that draws characters and
# backgrounds. It must support transparent backgrounds.
# "gpt-image-2.5-flare" is the fast everyday model.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Optional. A separate model for redrawing a character with its mouth open
# (an image edit). Defaults to OPENAI_IMAGE_MODEL.
# "gpt-image-2.5-sunburst" is OpenAI's more precise editing model.
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst

# Optional. Picture quality: low, medium or high. Higher costs more and takes
# longer. Leave blank for the model's default.
OPENAI_IMAGE_QUALITY=medium

# Needed for voices in Cartoon stories, unless SpeechGen is set up below.
# The text-to-speech model.
# "gpt-4o-mini-tts" lets each character be given its own manner of speaking.
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Optional, recommended: Google Gemini's voices, which act each line from a
# written direction and sound like real people talking, in English (with an
# Indian accent), Telugu, Hindi and the other Indian languages. When set, every
# story is spoken by Gemini. Create the key at aistudio.google.com. The free
# plan allows only 3 voice lines a minute; turn on billing in Google AI Studio
# for normal speed. Read on the server only and never sent to the browser.
GEMINI_API_KEY=
# Optional: another Gemini speech model. Default: gemini-3.8-flash-tts.
GEMINI_TTS_MODEL=

# Optional, for India: Sarvam AI's real Indian voices (Bulbul v3)
# for Indian English, Hindi, Telugu, Tamil, Kannada, Malayalam, Marathi,
# Bengali, Gujarati, Punjabi and Odia. When set, every story in those languages
# is spoken by Sarvam; other languages keep OpenAI's voices. Create the key at
# dashboard.sarvam.ai. Read on the server only and never sent to the browser.
SARVAM_API_KEY=

# Optional. Use SpeechGen (https://speechgen.io) for the voices instead of
# OpenAI. It has real children's and older voices in English, and Hindi,
# Telugu, Tamil and many other languages. Set BOTH lines to switch it on; leave
# both blank to keep OpenAI's voices. The token is on your SpeechGen profile
# page, and the email is the one you log in to SpeechGen with. Like the OpenAI
# key, these are read on the server only and never sent to the browser.
SPEECHGEN_API_TOKEN=
SPEECHGEN_EMAIL=

# Optional. Which accent to prefer when a language has several, for example
# "Indian" for English (Indian), or "US" or "British". Default: Indian.
SPEECHGEN_ACCENT=Indian

# Needed for the "Speak instead of typing" button. The speech-to-text model.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Optional. Moderation model used to screen what people type.
# Defaults to OpenAI's evergreen alias "omni-moderation-latest".
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Optional. Text requests allowed per IP address per minute. Default: 10.
RATE_LIMIT_PER_MINUTE=10

# Optional. Pictures allowed per IP address per minute. Default: 24.
# Each character needs up to 4 pictures and each background 1.
RATE_LIMIT_IMAGES_PER_MINUTE=24

# Optional. Spoken lines allowed per IP address per minute. Default: 60.
RATE_LIMIT_SPEECH_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Sign-in (optional). Leave ALL of these blank and the app is open to anyone
# with the link, as before. Set AUTH_SECRET and at least one way of signing in
# (Google or email) and people must sign in first. See "Sign-in" in the README.
# ---------------------------------------------------------------------------

# Signs the cookie that keeps people signed in. A long random value of your
# own: run `openssl rand -base64 32` and paste the result. Keep it secret.
# Changing it signs everyone out.
AUTH_SECRET=

# "Continue with Google". Both values come from a Google Cloud OAuth client
# (type: Web application). Its redirect address must be
#   https://YOUR-SITE/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Email me a code". Any mail service that offers SMTP works. With a Gmail
# account: host smtp.gmail.com, port 465, user = the Gmail address, password =
# an app password from https://myaccount.google.com/apppasswords (NOT your
# normal Gmail password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional. The sender shown on the email. Defaults to SMTP_USER.
# Example: Explainer Studio <you@gmail.com>
AUTH_EMAIL_FROM=

# Optional. Who may sign in: email addresses and/or whole domains, separated by
# commas. Example: ana@example.org, ben@gmail.com, @myschool.edu
# Blank means anyone with a Google account or an email address can sign in and
# use your OpenAI and SpeechGen credit.
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Posting straight to YouTube (optional). Needs Google sign-in above, and in
# the same Google Cloud project: the YouTube Data API v3 switched on, the
# youtube.upload scope added, and this extra redirect address on the client:
#   https://YOUR-SITE/api/youtube/callback
# See "Posting to YouTube" in the README.
# ---------------------------------------------------------------------------

# "on" shows the Upload to YouTube button under a finished video.
YOUTUBE_UPLOADS=
# Optional. How new videos appear: public (default), unlisted or private.
YOUTUBE_PRIVACY=public
# Optional. YouTube category number. 27 is Education.
YOUTUBE_CATEGORY_ID=27

# Optional. Video Insights, the separate app in insights/ that follows how each
# uploaded video is doing. Set BOTH to have Studio tell it about each upload;
# leave both blank to switch it off. The secret must be the same value as in
# Insights' own settings. See "Video Insights" in the README.
INSIGHTS_URL=
INSIGHTS_SECRET=
