# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your OpenAI API key. Read on the server only; it is never sent to the browser
# and never logged. Leave it blank to run in "bring your own key" mode, where
# each visitor pastes their own key (held in their browser's memory only).
OPENAI_API_KEY=

# Required. The text model that structures prompts and writes storyboards.
# Model names change: check https://developers.openai.com/api/docs/models
# "gpt-6.1-sol" balances quality and cost; "gpt-6-luna" is cheaper and faster.
OPENAI_TEXT_MODEL=gpt-6.1-sol

# Optional. How hard the model "thinks" (for example: low, medium, high).
# Lower is faster and cheaper. Leave blank to use the model's default, or if
# your model does not support reasoning settings.
OPENAI_REASONING_EFFORT=low

# Optional. Moderation model used to screen what people type.
# Defaults to OpenAI's evergreen alias "omni-moderation-latest".
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Optional. Requests allowed per IP address per minute, shared across the
# three API routes. Default: 10.
RATE_LIMIT_PER_MINUTE=10
